{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "python -m jin_market_pulse.cron",
    "cronSchedule": "5,20,35,50 * * * *",
    "sleepApplication": false,
    "limitOverride": {
      "containers": {
        "cpu": 0.25,
        "memoryBytes": 268435456
      }
    },
    "restartPolicyType": "NEVER"
  }
}
