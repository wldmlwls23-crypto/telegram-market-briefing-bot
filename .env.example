TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_WEB_SEARCH=true
RUN_MODE=serverless
RUN_ON_START=false
CRON_SECRET=replace_with_a_long_random_value
TELEGRAM_WEBHOOK_SECRET=replace_with_a_different_long_random_value
ENABLE_AI_ADVISOR=true
AI_ADVISOR_DAILY_LIMIT=5
STATE_DIR=/data
ENABLED_REPORTS=morning
ENABLE_EMERGENCY_ALERTS=false
FMP_API_KEY=
REQUEST_TIMEOUT_SECONDS=25
